# DATABASE DIRECT CONNECTION URI (PostgreSQL / Supabase / Neon / Cloud SQL)
# Direct connection string format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres.myproject:mypassword@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Public Client Variables)
# Optional: If not provided, MHM SOLUTIONS automatically uses the direct URI backend or simulation mode.
VITE_SUPABASE_URL="https://uxdfrnogiuefoqjpobpf.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# EXTENSION & EDGE FUNCTION SECURITY TOKEN
# Jeton secret partagé entre l'extension Chrome (config.js), l'Edge Function mhmbac-sync et le serveur API backend
MHM_SYNC_TOKEN="votre_jeton_secret_sync_mhmbac"


